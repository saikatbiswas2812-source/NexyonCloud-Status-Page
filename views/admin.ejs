<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · NexyonCloud</title><link rel="stylesheet" href="/css/style.css"></head><body><header class="top"><a class="brand" href="/"><span class="logo">N</span><span>NexyonCloud <small>ADMIN</small></span></a><a class="back" href="/">← Public status page</a></header><main class="wrap admin"><div class="eyebrow">CONTROL CENTER</div><h1>Manage <span>services.</span></h1><p class="muted">Changes publish immediately to the public status page.</p><section class="panel"><h2>Add a service</h2><form method="post" action="/admin/service" class="form"><input name="name" placeholder="Service name" required><input name="description" placeholder="Short description"><select name="status"><option value="operational">Operational</option><option value="degraded">Degraded</option><option value="outage">Outage</option><option value="maintenance">Maintenance</option></select><button>Add service</button></form></section><section class="panel"><h2>Current services</h2><% services.forEach(s=>{ %><form method="post" action="/admin/service/<%=s.id%>" class="manage"><input name="name" value="<%=s.name%>" required><input name="description" value="<%=s.description%>"><select name="status"><% ["operational","degraded","outage","maintenance"].forEach(x=>{ %><option value="<%=x%>" <%=s.status===x?"selected":""%>><%=x%></option><% }) %></select><button>Save</button></form><form method="post" action="/admin/service/<%=s.id%>/delete" class="delete" onsubmit="return confirm('Delete this service?')"><button class="danger">Delete <%=s.name%></button></form><% }) %></section><section class="panel"><h2>Post an incident</h2><form method="post" action="/admin/incident" class="form"><select name="service_id"><option value="">General incident</option><% services.forEach(s=>{ %><option value="<%=s.id%>"><%=s.name%></option><% }) %></select><input name="title" placeholder="Incident title" required><input name="message" placeholder="Update message" required><select name="status"><option value="investigating">Investigating</option><option value="identified">Identified</option><option value="monitoring">Monitoring</option></select><button>Publish incident</button></form></section><section class="panel"><h2>Incident history</h2><% incidents.forEach(i=>{ %><div class="incident-row"><div><b><%=i.title%></b><p class="muted"><%=i.message%> · <%=i.status%></p></div><% if(i.status!=="resolved"){ %><form method="post" action="/admin/incident/<%=i.id%>/resolve"><button>Resolve</button></form><% } %></div><% }) %></section></main></body></html>