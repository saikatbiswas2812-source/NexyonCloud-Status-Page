<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · NexyonCloud</title><link rel="stylesheet" href="/css/style.css"></head><body><header class="top"><a class="brand" href="/"><span class="logo">N</span><span>NexyonCloud <small>ADMIN CONTROL</small></span></a><a class="back" href="/">← Public status page</a></header><main class="wrap admin"><div class="eyebrow">CONTROL CENTER</div><h1>Manage <span>services.</span></h1><p class="muted">Automatic checks every <%=interval%> seconds. Add a public health-check URL to enable monitoring.</p><form method="post" action="/admin/check-now"><button>Run checks now</button></form>
<section class="panel"><h2>Add a service</h2><form method="post" action="/admin/service" class="form vertical"><input name="name" placeholder="Service name" required><input name="description" placeholder="Short description"><input name="url" type="url" placeholder="Public health URL (https://...) — optional"><select name="status"><option value="unknown">Not monitored yet</option><option value="operational">Operational (manual)</option><option value="degraded">Degraded</option><option value="outage">Outage</option><option value="maintenance">Maintenance</option></select><button>Add service</button></form><p class="hint">Use a URL that returns HTTP 2xx or 3xx when healthy. Do not enter private IPs, localhost URLs, or URLs containing passwords.</p></section>
<section class="panel"><h2>Service configuration</h2><% services.forEach(s=>{ %><form method="post" action="/admin/service/<%=s.id%>" class="service-editor"><div class="editor-grid"><input name="name" value="<%=s.name%>" required aria-label="Service name"><input name="description" value="<%=s.description%>" placeholder="Description" aria-label="Description"><input name="url" type="url" value="<%=s.url||''%>" placeholder="Public health URL (https://...)" aria-label="Health URL"><select name="status" aria-label="Status"><% ["unknown","operational","degraded","outage","maintenance"].forEach(x=>{ %><option value="<%=x%>" <%=s.status===x?"selected":""%>><%=x%></option><% }) %></select></div><label class="toggle"><input type="checkbox" name="enabled" <%=s.enabled?"checked":""%>> Enable automatic monitoring</label><div class="editor-actions"><button>Save changes</button><span class="muted"><%=s.last_checked?"Last check: "+s.last_checked:"Never checked"%></span></div></form><form method="post" action="/admin/service/<%=s.id%>/delete" class="delete" onsubmit="return confirm('Delete this service and its check history?')"><button class="danger">Delete <%=s.name%></button></form><% }) %></section>
<section class="panel"><h2>Post an incident</h2><form method="post" action="/admin/incident" class="form vertical"><select name="service_id"><option value="">General incident</option><% services.forEach(s=>{ %><option value="<%=s.id%>"><%=s.name%></option><% }) %></select><input name="title" placeholder="Incident title" required><textarea name="message" placeholder="Update message" required></textarea><select name="status"><option value="investigating">Investigating</option><option value="identified">Identified</option><option value="monitoring">Monitoring</option></select><button>Publish incident</button></form></section>
<section class="panel"><h2>Incident history</h2><% if(!incidents.length){ %><p class="muted">No incidents recorded.</p><% } incidents.forEach(i=>{ %><div class="incident-row"><div><b><%=i.title%></b><p class="muted"><%=i.service_name||"General"%> · <%=i.message%> · <%=i.status%></p></div><% if(i.status!=="resolved"){ %><form method="post" action="/admin/incident/<%=i.id%>/resolve"><button>Resolve</button></form><% } %></div><% }) %></section></main></body></html>